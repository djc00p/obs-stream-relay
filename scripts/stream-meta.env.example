# Stream metadata credentials
# ----------------------------
# Used by tools/stream-meta.sh to set the stream title and category via
# each platform's API. RTMP carries no metadata, so this is a separate
# layer from the relay.
#
# Mode 600. Do not commit.
#
# Copy to the repository root:
#     cp scripts/stream-meta.env.example stream-meta.env
#     chmod 600 stream-meta.env
#
# The token helpers WRITE this file for you. Do not copy and paste
# credential values by hand -- an OAuth authorization code and an access
# token look nearly identical, and pasting the wrong one gives a
# confusing 401.

# --- Twitch ---------------------------------------------------------------
# Get a Client-ID: https://dev.twitch.tv/console/apps
# Then run: ./tools/twitch-token.sh
# The helper opens the browser, reads the token out of the redirect, and
# writes TWITCH_TOKEN here.
TWITCH_CLIENT_ID=
TWITCH_TOKEN=

# Optional: your numeric Twitch user id. Resolved automatically if blank
# (a login name is not accepted -- the API wants digits).
TWITCH_USER_ID=

# Optional: your login, for reference.
TWITCH_CHANNEL_LOGIN=

# --- Kick -----------------------------------------------------------------
# Create an app at https://dev.kick.com/applications
# Redirect URI: https://localhost
# Then run: ./tools/kick-token.sh
#
# Access tokens last 2 hours. The refresh token lasts 30 days on a
# sliding window (every refresh resets the clock), so keep it.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_TOKEN=
KICK_REFRESH_TOKEN=

# Your Kick channel slug (the part after kick.com/).
KICK_CHANNEL_SLUG="your-handle"

# --- YouTube --------------------------------------------------------------
# YouTube needs TWO credentials:
#   YT_API_KEY  -- public reads (channel lookup, category list)
#   YT_TOKEN    -- act as the channel (changing a title)
# The API key ALONE cannot change a stream title.
#
# Setup:
#   1. Enable "YouTube Data API v3" in APIs & Services -> Library.
#   2. Create an API key (Credentials -> Create Credentials -> API key ->
#      Public data).
#   3. Create an OAuth client (Credentials -> Create Credentials -> OAuth
#      client ID -> Web application), redirect URI https://localhost.
#   4. Run: ./tools/youtube-token.sh
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_TOKEN=
YT_REFRESH_TOKEN=
YT_API_KEY=

# Your channel. Either the numeric UC... id or the @handle works --
# the tools resolve one from the other.
YT_CHANNEL_ID=
YT_CHANNEL_HANDLE=

# Optional: pin one specific broadcast instead of discovering the live one.
YT_BROADCAST_ID=

# Optional: YouTube category id. 20 is Gaming. Leave blank to change only
# the title.
YT_CATEGORY_ID=

# --- Defaults -------------------------------------------------------------
# Applied to every platform when --title / --game are not passed.
STREAM_TITLE=
STREAM_GAME=
